{
  "name": "xsin-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @xsin/web dev",
    "build": "pnpm --filter @xsin/content build && pnpm --filter @xsin/web build",
    "preview": "pnpm --filter @xsin/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "content": "pnpm --filter @xsin/content collect",
    "content:offline": "pnpm --filter @xsin/content build"
  }
}
